EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_MARKETPLACE_ID=EBAY_US
# eBay calls this the OAuth redirect name (RuName). Configure its accepted URL as:
# https://wmvffpuxrdbsexryazxu.supabase.co/functions/v1/market-data?action=ebay-oauth-callback
EBAY_RUNAME=your-ebay-runame
EBAY_USER_SCOPES=https://api.ebay.com/oauth/api_scope/sell.fulfillment
# Marketplace Insights sold-comps access is restricted by eBay. Keep this false
# unless eBay has explicitly approved the application.
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false
EBAY_SPORTS_CARD_CATEGORY_IDS=

# Generate a private random secret of at least 32 characters. Never expose it in
# the website or commit its real value.
MARKETPLACE_TOKEN_ENCRYPTION_KEY=replace-with-a-private-random-secret
APP_BASE_URL=http://127.0.0.1:4180/index.html
APP_ALLOWED_ORIGINS=http://127.0.0.1:4180,http://localhost:4180

PSA_API_TOKEN=your-psa-public-api-token
# CardHobby currently has no documented public API. Only configure these after
# CardHobby grants an approved partner endpoint and token.
CARDHOBBY_API_BASE=
CARDHOBBY_SALES_API_URL=
CARDHOBBY_API_TOKEN=

# Card Ladder and Market Movers prohibit unapproved automated harvesting.
# Configure these only after receiving a licensed API/partner endpoint. Endpoints
# may accept ?q=... or use a {query} placeholder. Tokens remain server-side.
CARDLADDER_TREND_API_URL=
CARDLADDER_API_TOKEN=
MARKET_MOVERS_TREND_API_URL=
MARKET_MOVERS_API_TOKEN=
