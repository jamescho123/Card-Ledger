    "添加卡片后会显示在这里。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cards appear here after you add them." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "カードを追加するとここに表示されます。" } } } },
    "本地" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On Device" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "端末内" } } } },
    "查询 PSA 评级数量" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Look Up PSA Population" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "PSA 鑑定枚数を検索" } } } },
    "评级证书编号" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Grading Certificate Number" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "鑑定証明番号" } } } },
    "百卡藏家" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "100-Card Collector" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "100枚コレクター" } } } },
    "首张入藏" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "First Card Added" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "最初のカード" } } } },
    "选择卡片后显示卡图" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Card image appears after selection" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択後にカード画像を表示" } } } },
    "寻找这张文班亚马多次 5x5 里程碑 Topps NOW 卡。支持面对面核验或平台交易。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Looking for this Wembanyama multiple-5x5 milestone Topps NOW card. Open to in-person verification or platform trades." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ウェンバンヤマの複数回5x5達成 Topps NOW カードを探しています。対面確認またはプラットフォーム取引に対応します。" } } } },
    "云端短信尚未启用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud SMS is not enabled" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クラウドSMSは未設定です" } } } },
    "中国大陆手机号将以 +86 1xxxxxxxxxx 发送" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mainland China numbers are sent as +86 1xxxxxxxxxx" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "中国本土の番号は +86 1xxxxxxxxxx 形式で送信されます" } } } },
    "号码将转换为国际 E.164 格式" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The number will be converted to international E.164 format" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "番号は国際E.164形式に変換されます" } } } },
    "Supabase 微信服务商尚未启用" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Supabase WeChat provider is not enabled" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "SupabaseのWeChatプロバイダーは未設定です" } } } },
    "需要配置微信 App ID 与 Universal Link" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A WeChat App ID and Universal Link are required" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChat App IDとユニバーサルリンクの設定が必要です" } } } },
    "请先安装并登录微信" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install and sign in to WeChat first" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "先にWeChatをインストールしてログインしてください" } } } },
    "将在微信 App 中请求授权" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission will be requested in the WeChat app" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatアプリ内で許可を求めます" } } } },
    "前往微信授权" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue in WeChat" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatで認証" } } } },
    "请输入有效的中国大陆手机号，例如 138 0000 0000。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a valid mainland China phone number, such as 138 0000 0000." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "138 0000 0000 のような有効な中国本土の電話番号を入力してください。" } } } },
    "请输入有效的手机号码。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a valid phone number." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "有効な電話番号を入力してください。" } } } },
    "微信登录尚未配置。请先添加微信开放平台 App ID、Universal Link，并在 Supabase 启用 custom:wechat。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat login is not configured. Add the WeChat Open Platform App ID and Universal Link, then enable custom:wechat in Supabase." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatログインは未設定です。WeChat Open PlatformのApp IDとユニバーサルリンクを追加し、Supabaseでcustom:wechatを有効にしてください。" } } } },
    "未检测到微信。请先安装并登录微信后再试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat was not detected. Install it and sign in, then try again." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatが見つかりません。インストールしてログイン後、もう一度お試しください。" } } } },
    "微信登录初始化失败。请检查 App ID、URL Scheme 与 Universal Link。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat login could not start. Check the App ID, URL scheme, and Universal Link." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatログインを開始できませんでした。App ID、URLスキーム、ユニバーサルリンクを確認してください。" } } } },
    "无法打开微信授权页面，请稍后重试。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The WeChat permission screen could not be opened. Try again shortly." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatの許可画面を開けませんでした。しばらくしてから再試行してください。" } } } },
    "你已取消微信授权。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You cancelled WeChat authorization." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChat認証をキャンセルしました。" } } } },
    "微信授权未获允许。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat authorization was not approved." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChat認証が許可されませんでした。" } } } },
    "微信没有返回有效的登录凭证。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat did not return valid login credentials." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChatから有効なログイン情報が返されませんでした。" } } } },
    "手机号登录尚未在云端启用。请在 Supabase 的 Authentication > Providers > Phone 中启用并配置中国大陆可送达的短信服务。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Phone login is not enabled in Supabase. Enable Phone under Authentication > Providers and configure an SMS service that can deliver to mainland China." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Supabaseで電話ログインが有効になっていません。Authentication > ProvidersでPhoneを有効にし、中国本土へ配信できるSMSサービスを設定してください。" } } } },
    "微信登录尚未在 Supabase 中启用。请先创建 custom:wechat 服务商。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WeChat login is not enabled in Supabase. Create the custom:wechat provider first." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "SupabaseでWeChatログインが有効になっていません。先にcustom:wechatプロバイダーを作成してください。" } } } },
    "Supabase 的微信服务商配置无效，请检查授权地址与回调地址。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Supabase WeChat provider is invalid. Check its authorization and callback URLs." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "SupabaseのWeChatプロバイダー設定が無効です。認証URLとコールバックURLを確認してください。" } } } },
    "微信 App ID 与 Supabase 服务商配置不一致。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The WeChat App ID does not match the Supabase provider." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "WeChat App IDがSupabaseプロバイダーと一致しません。" } } } }
  },
  "version" : "1.0"
}
